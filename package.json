{
  "name": "discord-player-bot",
  "version": "4.0.0",
  "description": "A discord music bot built using discord.js and discord-player",
  "keywords": [
    "bun",
    "discord-bot",
    "deejay",
    "music-bot",
    "discord-music",
    "discord-player"
  ],
  "homepage": "https://github.com/LakhindarPal/discord-player-bot#readme",
  "bugs": {
    "url": "https://github.com/LakhindarPal/discord-player-bot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LakhindarPal/discord-player-bot.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "Lakhindar Pal",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "tsc": "tsc --noEmit",
    "check": "biome check --write",
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "register": "bun run scripts/register.ts",
    "docs": "bun run scripts/docgen.ts",
    "podman:build": "podman build -t docker.io/lakhindarpal/discord-player-bot:latest -t lakhindarpal/discord-player-bot:latest .",
    "podman:start": "podman run --name discord-player-bot --rm --env-file .env lakhindarpal/discord-player-bot:latest",
    "podman:register": "podman run --rm --env-file .env lakhindarpal/discord-player-bot:latest bun run register",
    "podman:push": "podman push docker.io/lakhindarpal/discord-player-bot:latest"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "@snazzah/davey": "^0.1.12",
    "discord-player": "^7.2.0",
    "discord-player-applemusic": "^1.0.3",
    "discord-player-deezer": "^2.6.0",
    "discord-player-soundcloud": "^1.0.7",
    "discord-player-spotify": "^1.1.9",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
